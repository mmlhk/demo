# K10 (MT6765, k62v1_64_bsp_S30_254_incell_1036_dianshang) — TWRP recovery fstab
# Reconstructed from on-device evidence:
#   - GPT by-name table (dump/by_name_sizes.txt)
#   - super geometry via lpdump (system_a/product_a/vendor_a only; no system_ext/odm;
#     slot B has no extents)
#   - /vendor/etc/fstab.mt6765 (stock/system_etc_recovery.fstab)
#
# Notes:
#   * /metadata lives on partition `md_udc`, NOT `metadata` (stock fstab does the same).
#   * /data: ext4 + inlinecrypt + FBE v2 + metadata-encrypted
#     (keydirectory=/metadata/vold/metadata_encryption).
#   * No slotselect: only slot A has data (pseudo-A/B); TWRP resolves plain names
#     to _a partitions on this device.
#   * `boot` entry lets TWRP back up / restore / flash the boot_a partition directly.

#<src>                                        <mnt_point>   <type>  <mnt_flags>  <fs_mgr_flags>
system                                         /system       ext4    ro,barrier=1  wait,logical
product                                        /product       ext4    ro,barrier=1  wait,logical
vendor                                         /vendor        ext4    ro,barrier=1  wait,logical

/dev/block/platform/bootdevice/by-name/md_udc  /metadata      ext4    noatime,nosuid,nodev  wait,formattable

/dev/block/platform/bootdevice/by-name/userdata /data          ext4    noatime,nosuid,nodev,inlinecrypt  wait,formattable,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption

/dev/block/platform/bootdevice/by-name/boot     /boot          emmc    defaults     defaults
/dev/block/platform/bootdevice/by-name/para     /misc          emmc    defaults     defaults

# Useful MTK backup partitions (present in GPT)
/dev/block/platform/bootdevice/by-name/dtbo    /dtbo          emmc    defaults     defaults
/dev/block/platform/bootdevice/by-name/lk      /bootloader    emmc    defaults     defaults
/dev/block/platform/bootdevice/by-name/lk2     /bootloader2   emmc    defaults     defaults
/dev/block/platform/bootdevice/by-name/nvram   /nvram         emmc    defaults     defaults
/dev/block/platform/bootdevice/by-name/proinfo /proinfo       emmc    defaults     defaults
/dev/block/platform/bootdevice/by-name/seccfg  /seccfg        emmc    defaults     defaults
/dev/block/platform/bootdevice/by-name/logo    /logo          emmc    defaults     defaults
/dev/block/platform/bootdevice/by-name/expdb   /expdb         emmc    defaults     defaults

# External storage (no SD slot; keep USB OTG)
/devices/platform/externdevice*                auto           auto    defaults      voldmanaged=sdcard1:auto
/devices/platform/mt_usb*                      auto           vfat    defaults      voldmanaged=usbotg:auto
